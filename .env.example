# ScamSaathi environment. Copy to .env (`make env` generates random secrets for you).
# NEVER commit .env (NFR-4). Values marked <secret> are generated by scripts/gen-env.py.

# --- LLM (provider is not hardcoded) ---------------------------------------------------
# vertex        -> Vertex AI with a service-account JSON (GOOGLE_CREDENTIALS_FILE)
# openai_compat -> any OpenAI-compatible endpoint, e.g.
#                  Gemini AI Studio: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  Anthropic:        LLM_BASE_URL=https://api.anthropic.com/v1
LLM_PROVIDER=vertex
LLM_MODEL=gemini-3.5-flash-lite
# Thinking budget passed to providers that support it (Gemini 3: minimal|low|medium|high|max). Empty = provider default.
LLM_REASONING_EFFORT=minimal
LLM_API_KEY=
LLM_BASE_URL=
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=global
# Host path of the service-account JSON (mounted read-only into llm-gateway only)
GOOGLE_CREDENTIALS_FILE=./docs/google_credentials.json
LLM_TIMEOUT_S=20
AGENT_TIMEOUT_MS=20000

# --- WhatsApp -------------------------------------------------------------------------
# Admin gets bridge-down and campaign alerts. Format: <countrycode><number>@s.whatsapp.net
ADMIN_JID=91XXXXXXXXXX@s.whatsapp.net
# Optional dev allowlist: only these numbers get replies (comma-separated, with country code).
# Leave empty on a dedicated bot number to serve everyone.
SENDER_ALLOWLIST=

# --- Threat feeds (optional; a missing key just means that feed reports "unknown") ------
GSB_API_KEY=
VT_API_KEY=
URLHAUS_AUTH_KEY=
OPENPHISH_ENABLED=true
DETONATE_ENABLED=true

# --- Internal secrets <secret> --------------------------------------------------------
POSTGRES_USER=scamsaathi
POSTGRES_DB=scamsaathi
POSTGRES_PASSWORD=<secret>
REDIS_PASSWORD=<secret>
ANALYZER_TOKEN=<secret>
BRIDGE_TOKEN=<secret>
LLM_GATEWAY_TOKEN=<secret>
TEST_TOKEN=<secret>
ADMIN_TOKEN=<secret>
SENDER_SALT=<secret>
N8N_ENCRYPTION_KEY=<secret>
N8N_OWNER_EMAIL=admin@scamsaathi.local
N8N_OWNER_PASSWORD=<secret>

# --- Tuning ----------------------------------------------------------------------------
RATE_LIMIT_PER_HOUR=20
REGISTRY_INCLUDE_UNREVIEWED=true
N8N_IMAGE=n8nio/n8n:2.46.4

# Phase 1 echo test: set to wa-echo, then back to wa-inbound
BRIDGE_WEBHOOK_PATH=wa-inbound
# Optional out-of-band alert hook (ntfy/Slack/etc.) used when the bridge itself is down
ALERT_WEBHOOK_URL=
