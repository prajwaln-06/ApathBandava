    {
      "id": "de3cbfa3-b2fc-5759-9b23-a8af024849d8",
      "name": "Merge + schema validation (drop unknown codes)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "jsCode": "\n// Merge agent results; validate against SRS 6.4; drop unknown codes; timeouts/errors -> unknown.\nconst CODES = new Set([\"APK_DOWNLOAD\", \"AT_IN_URL\", \"AUTHORITY_CLAIM\", \"CERT_AGE_LT_30D\", \"CREDENTIAL_REQUEST\", \"DOMAIN_AGE_LT_30D\", \"HOMOGLYPH_OR_BRAND_IN_SUBDOMAIN\", \"IP_HOST\", \"LOOKALIKE_DOMAIN\", \"PAGE_ASKS_PIN_OTP_CARD\", \"PERSONAL_UPI_PAYMENT\", \"PHONE_NOT_OFFICIAL\", \"PLAYBOOK_MATCH\", \"POLICY_VIOLATION\", \"PUNYCODE\", \"REGISTRY_DOMAIN_MISMATCH\", \"REGISTRY_FULL_MATCH\", \"REMOTE_ACCESS_REQUEST\", \"REWARD_LURE\", \"RISKY_TLD\", \"SENDER_ID_MISMATCH\", \"SHORTENER\", \"THREAT_FEED_HIT\", \"UPI_COLLECT_REQUEST\", \"UPI_HANDLE_NOT_OFFICIAL\", \"UPI_PAY_AS_RECEIVE\", \"URGENCY_LANGUAGE\"]);\nconst AGENTS = ['rules', 'wording', 'link', 'impersonation', 'scamtype'];  // deterministic evidence first\nconst SEV = {\"APK_DOWNLOAD\": \"medium\", \"AT_IN_URL\": \"medium\", \"AUTHORITY_CLAIM\": \"low\", \"CERT_AGE_LT_30D\": \"low\", \"CREDENTIAL_REQUEST\": \"medium\", \"DOMAIN_AGE_LT_30D\": \"medium\", \"HOMOGLYPH_OR_BRAND_IN_SUBDOMAIN\": \"high\", \"IP_HOST\": \"medium\", \"LOOKALIKE_DOMAIN\": \"high\", \"PAGE_ASKS_PIN_OTP_CARD\": \"high\", \"PERSONAL_UPI_PAYMENT\": \"medium\", \"PHONE_NOT_OFFICIAL\": \"medium\", \"PLAYBOOK_MATCH\": \"medium\", \"POLICY_VIOLATION\": \"high\", \"PUNYCODE\": \"low\", \"REGISTRY_DOMAIN_MISMATCH\": \"high\", \"REGISTRY_FULL_MATCH\": \"trust\", \"REMOTE_ACCESS_REQUEST\": \"high\", \"REWARD_LURE\": \"medium\", \"RISKY_TLD\": \"low\", \"SENDER_ID_MISMATCH\": \"medium\", \"SHORTENER\": \"low\", \"THREAT_FEED_HIT\": \"hard\", \"UPI_COLLECT_REQUEST\": \"high\", \"UPI_HANDLE_NOT_OFFICIAL\": \"medium\", \"UPI_PAY_AS_RECEIVE\": \"hard\", \"URGENCY_LANGUAGE\": \"low\"};  // authoritative table from analyzer/app/signals.py\nconst reqs = $('Build agent requests').all().map(i => i.json.agent);\nconst outs = $input.all().map(i => i.json);\nconst byAgent = {};\nreqs.forEach((agent, idx) => {\n  let o = outs[idx];\n  if (o && typeof o.output === 'object') o = o.output;\n  if (typeof o === 'string') { try { o = JSON.parse(o); } catch (e) { o = null; } }\n  const valid = o && typeof o === 'object' && ['ok', 'unknown'].includes(o.status) && Array.isArray(o.signals);\n  if (!valid) { byAgent[agent] = { agent, status: 'unknown', signals: [], summary: '' }; return; }\n  const signals = o.signals.filter(s => s && CODES.has(s.code)).slice(0, 12).map(s => ({\n    code: s.code, severity: SEV[s.code],\n    evidence: String(s.evidence || '').slice(0, 300),\n    source_url: (typeof s.source_url === 'string' && /^https?:\\/\\//.test(s.source_url)) ? s.source_url.slice(0, 500) : null,\n  }));\n  byAgent[agent] = { agent, status: o.status, signals, summary: String(o.summary || '').slice(0, 200) };\n});\nconst findings = AGENTS.map(a => byAgent[a] || { agent: a, status: 'unknown', signals: [], summary: '' });\nreturn [{ json: { findings, dropped: outs.length - findings.filter(f => f.status === 'ok').length } }];\n"
      }
    },
