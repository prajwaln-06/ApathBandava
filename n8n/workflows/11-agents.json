      "typeVersion": 4.2,
      "position": [
        760,
        920
      ],
      "parameters": {
        "toolDescription": "Compare claimed brands, URLs, SMS sender IDs, phones and UPI IDs with the Official Channels Registry. Pass each list as comma-separated text (empty string if none).",
