        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brands: String($fromAI('brands', 'comma-separated claimed brand names, or empty', 'string') || '').split(',').map(x => x.trim()).filter(Boolean), urls: String($fromAI('urls', 'comma-separated URLs, or empty', 'string') || '').split(',').map(x => x.trim()).filter(Boolean), sender_ids: String($fromAI('sender_ids', 'comma-separated SMS sender IDs like VM-SBIBNK-S, or empty', 'string') || '').split(',').map(x => x.trim()).filter(Boolean), phones: String($fromAI('phones', 'comma-separated phone numbers, or empty', 'string') || '').split(',').map(x => x.trim()).filter(Boolean), upi_ids: String($fromAI('upi_ids', 'comma-separated UPI IDs, or empty', 'string') || '').split(',').map(x => x.trim()).filter(Boolean), text: $fromAI('text', 'the message text', 'string') }) }}",
        "options": {
          "timeout": 8000
        }
